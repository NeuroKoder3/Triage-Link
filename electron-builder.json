{
  "appId": "com.triagelink.app",
  "productName": "TriageLink",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!node_modules/.cache"
  ],
  "asar": true,
  "extraResources": [
    {
      "from": "assets/",
      "to": "assets/",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.medical",
    "icon": "assets/icon.icns"
  },
  "win": {
    "target": ["nsis", "zip"],
    "icon": "assets/icon.png"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Medical",
    "icon": "assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  }
}
